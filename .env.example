# Root .env, read by docker-compose. Placeholders only; never commit the real .env.

# Owner / migration role (superuser inside the container). Used only by Prisma migrate + seed.
DB_USER=acrms
DB_PASSWORD=<generate-a-strong-password>
DB_NAME=acrms

# Runtime role acrms_app (no superuser, no BYPASSRLS), created on first volume init.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_DB_PASSWORD=<generate-a-strong-password>
