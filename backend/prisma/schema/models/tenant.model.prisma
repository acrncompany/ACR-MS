/// Root of the multi-tenant hierarchy (no tenantId). RLS limits acrms_app to the current
/// tenant's own row; resolving a tenant by subdomain before login goes through the
/// SECURITY DEFINER function resolve_tenant_by_slug(slug).
model Tenant {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  /// Subdomain / lookup key, e.g. "acr" for acr.example.com. Lowercase (CHECK constraint).
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  createdBy String?      @db.Uuid
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?    @db.Timestamptz(3)

  settings          TenantSettings?
  companies         Company[]
  branches          Branch[]
  orgDepartments    OrgDepartment[]
  orgPositions      OrgPosition[]
  users             User[]
  userBranchAccess  UserBranchAccess[]
  roles             Role[]
  rolePermissions   RolePermission[]
  userRoles         UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  codeSequences     CodeSequence[]
  organisationTypes OrganisationType[]
  complianceLaws    ComplianceLaw[]
  clients           Client[]
  clientDirectors   ClientDirector[]
  clientLaws        ClientLaw[]
  clientTeam        ClientTeamMember[]
  clientCredentials ClientCredential[]
  departments       Department[]
  designations      Designation[]
  employees         Employee[]

  @@map("tenants")
}
