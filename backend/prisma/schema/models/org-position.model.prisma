/// A seat in the reporting hierarchy. parentPositionId is the reporting line.
model OrgPosition {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String    @db.Uuid
  departmentId     String    @db.Uuid
  parentPositionId String?   @db.Uuid
  /// Default role given to people in this position.
  roleId           String?   @db.Uuid
  code             String
  name             String
  /// The CEO's short label (TM, TL, TD, AD, GM, P1). DISPLAY ONLY: the hierarchy comes from
  /// parentPositionId and users.managerId, never from this code. Nullable until confirmed.
  designationCode  String?
  /// Sees every record in the tenant (Board, GM).
  seesAll          Boolean   @default(false)
  /// Can access every branch without user_branch_access rows (Board, GM).
  allBranches      Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  createdBy        String?   @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department OrgDepartment @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  parent     OrgPosition?  @relation("PositionTree", fields: [tenantId, parentPositionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children   OrgPosition[] @relation("PositionTree")
  role       Role?         @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  users      User[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, parentPositionId])
  @@index([tenantId, roleId])
  @@map("org_positions")
}
