/// Append-only: UPDATE/DELETE/TRUNCATE are blocked by trigger, and acrms_app has INSERT and
/// SELECT only. No updatedAt/createdBy/deletedAt. Needs monthly partitioning later.
model AuditLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String?  @db.Uuid
  /// Actor; null for system actions.
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  user   User?   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
  @@map("audit_logs")
}
