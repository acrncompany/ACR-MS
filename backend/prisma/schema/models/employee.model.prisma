/// Employee (Employees). Optionally has a department and a designation. Independent of staff
/// accounts (`users`). `code` (HRE-0001...) is permanent: issued once, never reused.
model Employee {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String    @db.Uuid
  code          String
  name          String
  email         String    @default("")
  phone         String    @default("")
  departmentId  String?   @db.Uuid
  designationId String?   @db.Uuid
  dateOfJoining DateTime  @db.Date
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdBy     String?   @db.Uuid
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department  Department?  @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  designation Designation? @relation(fields: [tenantId, designationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@map("employees")
}
