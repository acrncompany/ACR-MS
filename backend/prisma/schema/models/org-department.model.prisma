model OrgDepartment {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @db.Uuid
  code      String
  name      String
  parentId  String?   @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent    OrgDepartment?  @relation("DepartmentTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children  OrgDepartment[] @relation("DepartmentTree")
  positions OrgPosition[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("org_departments")
}
