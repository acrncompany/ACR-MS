model Department {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @db.Uuid
  code      String
  name      String
  parentId  String?   @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent    Department?  @relation("DepartmentTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children  Department[] @relation("DepartmentTree")
  positions Position[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("departments")
}

/// A seat in the reporting hierarchy. parentPositionId is the reporting line.
model Position {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String    @db.Uuid
  departmentId     String    @db.Uuid
  parentPositionId String?   @db.Uuid
  /// Default role given to people in this position.
  roleId           String?   @db.Uuid
  code             String
  name             String
  /// Sees every record in the tenant (Board).
  seesAll          Boolean   @default(false)
  /// Can access every branch without user_branch_access rows (Board, GM).
  allBranches      Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  createdBy        String?   @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  parent     Position?  @relation("PositionTree", fields: [tenantId, parentPositionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children   Position[] @relation("PositionTree")
  role       Role?      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  users      User[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, parentPositionId])
  @@index([tenantId, roleId])
  @@map("positions")
}

model User {
  id               String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String     @db.Uuid
  /// Always lowercase (CHECK constraint). Unique per tenant among non-deleted users.
  email            String
  name             String
  phone            String?
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  positionId       String?    @db.Uuid
  managerId        String?    @db.Uuid
  homeBranchId     String?    @db.Uuid
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  createdBy        String?    @db.Uuid
  updatedAt        DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?  @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  position     Position?          @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  manager      User?              @relation("UserManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reports      User[]             @relation("UserManager")
  homeBranch   Branch?            @relation(fields: [tenantId, homeBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  branchAccess UserBranchAccess[]
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@unique([tenantId, id])
  @@unique([tenantId, email], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@index([tenantId, positionId])
  @@index([tenantId, managerId])
  @@index([tenantId, homeBranchId])
  @@map("users")
}

/// Branches a user may access. Join table: hard delete; every add/remove writes an audit_logs row.
model UserBranchAccess {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdBy String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, userId, branchId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("user_branch_access")
}
