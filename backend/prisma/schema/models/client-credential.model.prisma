/// One encrypted portal credential field of a client (shared by every work sheet of that client).
/// Only ciphertext, iv, auth tag and the key id are stored (AES-256-GCM, per-tenant key derived
/// with HKDF from CREDENTIAL_MASTER_KEY). `field` is e.g. "mca.password". Never returned by any
/// list/get endpoint, never logged.
model ClientCredential {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @db.Uuid
  clientId   String   @db.Uuid
  field      String
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  /// Which derived key encrypted this row, so keys can be rotated later.
  keyId      String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  createdBy  String?  @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, clientId, field])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@map("client_credentials")
}
