// Global reference data. These are the ONLY tables (with permissions) without tenantId.
// They have no RLS; the runtime role acrms_app can only SELECT them.

model Currency {
  /// ISO 4217 code, e.g. INR
  code          String   @id @db.Char(3)
  name          String
  symbol        String
  decimalPlaces Int      @default(2) @db.SmallInt
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  countries Country[]
  companies Company[]

  @@map("currencies")
}

model Country {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// ISO 3166-1 alpha-2, e.g. IN
  isoCode         String   @unique @db.Char(2)
  name            String
  currencyCode    String   @db.Char(3)
  /// E.164 prefix without "+", e.g. 91
  phoneCode       String
  /// IANA zone, e.g. Asia/Kolkata
  defaultTimezone String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  currency  Currency  @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  regions   Region[]
  companies Company[]
  branches  Branch[]

  @@index([currencyCode])
  @@map("countries")
}

/// State / province / emirate.
model Region {
  id        String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  countryId String     @db.Uuid
  code      String
  name      String
  type      RegionType
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  districts District[]
  branches  Branch[]

  @@unique([countryId, code])
  @@map("regions")
}

model District {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  regionId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cities   City[]
  branches Branch[]

  @@unique([regionId, name])
  @@map("districts")
}

model City {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  districtId String   @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branches Branch[]

  @@unique([districtId, name])
  @@map("cities")
}
