/// Department (Employees > Departments). Independent of the organisation hierarchy
/// (`org_departments`, `org_positions`, `users`): it feeds no permission or visibility rule.
/// `code` (DEP-0001...) is issued once from `code_sequences`, never typed in, never changed
/// (trigger) and never reused.
model Department {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String    @db.Uuid
  code        String
  name        String
  description String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdBy   String?   @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  designations Designation[]
  employees    Employee[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@map("departments")
}
