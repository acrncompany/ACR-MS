/// Data-driven list of compliances a client can be subject to (MCA, TDS, GST ...). The CEO's
/// short forms are kept AS-IS. LATER: each law will carry a recurring due-date schedule.
/// This is the "Works" master (Masters tab "Works"); `code` (WRK-0001...) is permanent: issued
/// once, never reused, never typed in. It feeds the client form's "Applicable laws" list.
model ComplianceLaw {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @db.Uuid
  code      String
  key       String
  label     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String?   @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clients ClientLaw[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, key], where: raw("\"deletedAt\" IS NULL"))
  @@index([tenantId])
  @@map("compliance_laws")
}
