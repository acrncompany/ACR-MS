NODE_ENV=development
PORT=3015
LOG_LEVEL=debug

# Placeholders only. Use your own database credentials in .env (never commit .env).
# Runtime connection: the acrms_app role (NOT superuser, NO BYPASSRLS), so row-level
# security is always enforced. Password = APP_DB_PASSWORD from the root .env.
DATABASE_URL=postgresql://acrms_app:APP_DB_PASSWORD@localhost:5433/acrms?schema=public

# Owner role, used ONLY by the Prisma CLI (migrate, seed) through prisma.config.ts.
# The running backend never reads it. Password = DB_PASSWORD from the root .env.
MIGRATION_DATABASE_URL=postgresql://acrms:DB_PASSWORD@localhost:5433/acrms?schema=public

# REQUIRED, no default. At least 32 characters, random, unique per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>

# Access token lifetime: <number><s|m|h|d>. Defaults to 15m when omitted.
JWT_EXPIRES_IN=15m

# Tenant is resolved from the subdomain: <slug>.<TENANT_BASE_DOMAIN>
TENANT_BASE_DOMAIN=localhost

# Comma-separated list of allowed browser origins (credentials are allowed for these)
CORS_ORIGINS=http://acr.localhost:4300

# Refresh-token cookie (httpOnly, SameSite=Strict, Secure when NODE_ENV=production).
REFRESH_COOKIE_NAME=acrms_rt
REFRESH_COOKIE_PATH=/api/v1/auth

# Login lockout: lock the account for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILURES failures.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Rate limits per IP within THROTTLE_TTL_SECONDS.
THROTTLE_TTL_SECONDS=60
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REFRESH_LIMIT=30
THROTTLE_DEFAULT_LIMIT=300

# Number of reverse proxies in front of the app (0 = none). Needed for the real client IP.
TRUST_PROXY=0

# DEV SEED ONLY (npx prisma db seed). Password for every demo user. Never set in production.
SEED_DEMO_PASSWORD=<generate-a-dev-only-password>

# REQUIRED, no default. 32 random bytes, base64. Master key for field-level encryption of client
# portal credentials (per-tenant keys are derived with HKDF). Never commit the real value;
# losing it makes stored credentials unrecoverable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_MASTER_KEY=<generate-32-random-bytes-as-base64>
# Id of the key used for NEW values (stored per row so keys can be rotated later). Default v1.
CREDENTIAL_KEY_ID=v1

# Folder for uploaded files (employee ID proofs, resumes, passbook copies). Default ./storage.
# Keep it outside the web root and include it in backups.
FILE_STORAGE_DIR=./storage
